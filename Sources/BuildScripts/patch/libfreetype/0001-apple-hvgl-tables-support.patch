+/****************************************************************************
+ *
+ * hvfload.c
+ *
+ *   HVF glyph loading (body).
+ *
+ * Copyright (C) 2025 by
+ * Apple Inc.
+ * written by Deborah Goldsmith <goldsmit@apple.com>
+ *
