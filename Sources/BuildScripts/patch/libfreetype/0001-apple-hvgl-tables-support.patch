 #define TTAG_gvar  FT_MAKE_TAG( 'g', 'v', 'a', 'r' )
 #define TTAG_HVAR  FT_MAKE_TAG( 'H', 'V', 'A', 'R' )
+#define TTAG_hvgl  FT_MAKE_TAG( 'h', 'v', 'g', 'l' )
+#define TTAG_hvpm  FT_MAKE_TAG( 'h', 'v', 'p', 'm' )
 #define TTAG_hdmx  FT_MAKE_TAG( 'h', 'd', 'm', 'x' )
